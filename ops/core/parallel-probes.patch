diff --git a/experimental/libbox/command_server_instances_lx_test.go b/experimental/libbox/command_server_instances_lx_test.go
new file mode 100644
index 0000000..5443630
--- /dev/null
+++ b/experimental/libbox/command_server_instances_lx_test.go
@@ -0,0 +1,144 @@
+package libbox
+
+import (
+	"context"
+	"net"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/daemon"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/emptypb"
+)
+
+type testStartedService struct {
+	daemon.UnimplementedStartedServiceServer
+}
+
+func (testStartedService) GetStartedAt(context.Context, *emptypb.Empty) (*daemon.StartedAt, error) {
+	return &daemon.StartedAt{}, nil
+}
+
+func startTestCommandServer(t *testing.T, secret string) (int32, func()) {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := grpc.NewServer(grpc.ChainUnaryInterceptor(unaryAuthInterceptor(secret)))
+	daemon.RegisterStartedServiceServer(server, testStartedService{})
+	go server.Serve(listener)
+	return int32(listener.Addr().(*net.TCPAddr).Port), server.Stop
+}
+
+func newTestCommandClient(port int32, secret string) *CommandClient {
+	client := NewCommandClient(nil, &CommandClientOptions{
+		CommandServerListenPort: port,
+		CommandServerUseTCP:     true,
+		CommandServerSecret:     secret,
+	})
+	client.standalone = true
+	return client
+}
+
+func connectTestCommandClient(t *testing.T, client *CommandClient) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	connection, _, err := client.establishConnection(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { connection.Close() })
+}
+
+func TestCommandClientUsesPerInstanceEndpointAndSecret(t *testing.T) {
+	firstPort, stopFirst := startTestCommandServer(t, "first-secret")
+	defer stopFirst()
+	secondPort, stopSecond := startTestCommandServer(t, "second-secret")
+	defer stopSecond()
+
+	firstClient := newTestCommandClient(firstPort, "first-secret")
+	secondClient := newTestCommandClient(secondPort, "second-secret")
+	connectTestCommandClient(t, firstClient)
+	connectTestCommandClient(t, secondClient)
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	wrongClient := newTestCommandClient(secondPort, "first-secret")
+	_, _, err := wrongClient.establishConnection(ctx)
+	if status.Code(err) != codes.Unauthenticated {
+		t.Fatalf("wrong secret error = %v", err)
+	}
+}
+
+func TestCommandClientReconnectKeepsInstanceEndpoint(t *testing.T) {
+	port, stop := startTestCommandServer(t, "reconnect-secret")
+	defer stop()
+	client := newTestCommandClient(port, "reconnect-secret")
+	connectTestCommandClient(t, client)
+	client.Disconnect()
+	connectTestCommandClient(t, client)
+
+	target, dialer := dialTargetFor(client.commandServerListenPort, client.commandServerUseTCP)
+	if target != net.JoinHostPort("127.0.0.1", strconv.Itoa(int(port))) || dialer != nil {
+		t.Fatalf("target = %q, dialer present = %v", target, dialer != nil)
+	}
+}
+
+func TestCommandInstancesPreserveProcessGlobalDefault(t *testing.T) {
+	oldBase, oldWorking, oldTemp := sBasePath, sWorkingPath, sTempPath
+	oldPort, oldSecret, oldXPC := sCommandServerListenPort, sCommandServerSecret, sXPCDialer
+	t.Cleanup(func() {
+		sBasePath, sWorkingPath, sTempPath = oldBase, oldWorking, oldTemp
+		sCommandServerListenPort, sCommandServerSecret, sXPCDialer = oldPort, oldSecret, oldXPC
+	})
+	sBasePath, sWorkingPath, sTempPath = "global-base", "global-work", "global-temp"
+	sCommandServerListenPort = 12345
+	sCommandServerSecret = "global-secret"
+	sXPCDialer = nil
+
+	resolved := resolveCommandServerOptions(nil)
+	if resolved.BasePath != sBasePath || resolved.WorkingPath != sWorkingPath || resolved.TempPath != sTempPath ||
+		resolved.CommandServerListenPort != int32(sCommandServerListenPort) || resolved.CommandServerSecret != sCommandServerSecret {
+		t.Fatalf("global defaults = %+v", resolved)
+	}
+	client := NewCommandClient(nil, &CommandClientOptions{})
+	if client.commandServerListenPort != 0 || client.commandServerUseTCP || client.authSecret() != sCommandServerSecret {
+		t.Fatalf("global client = %+v", client)
+	}
+	target, _ := dialTargetFor(int32(sCommandServerListenPort), client.commandServerUseTCP)
+	if target != net.JoinHostPort("127.0.0.1", "12345") {
+		t.Fatalf("global target = %q", target)
+	}
+}
+
+func TestCommandServerOptionsKeepEphemeralPortAndLocalPaths(t *testing.T) {
+	resolved := resolveCommandServerOptions(&CommandServerOptions{
+		CommandServerUseTCP: true,
+		CommandServerSecret: "instance-secret",
+		BasePath:            "instance-base",
+		WorkingPath:         "instance-work",
+		TempPath:            "instance-temp",
+	})
+	if resolved.CommandServerListenPort != 0 || !resolved.CommandServerUseTCP {
+		t.Fatalf("endpoint options = %+v", resolved)
+	}
+	if resolved.CommandServerSecret != "instance-secret" ||
+		resolved.BasePath != "instance-base" ||
+		resolved.WorkingPath != "instance-work" ||
+		resolved.TempPath != "instance-temp" {
+		t.Fatalf("instance options = %+v", resolved)
+	}
+}
+
+func TestCommandServerListenPortBeforeStart(t *testing.T) {
+	server := &CommandServer{}
+	if port := server.ListenPort(); port != 0 {
+		t.Fatalf("port before start = %d", port)
+	}
+}
